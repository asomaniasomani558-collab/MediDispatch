# MediDispatch GH - environment template. Copy to .env and fill in.
# NEVER commit the real .env.

# --- Required secrets ---------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-characters
# flask --app run.py generate-key     (comma-separate several keys to rotate;
# the FIRST key encrypts, all keys decrypt). Losing this key = losing patient data.
FIELD_ENCRYPTION_KEYS=

POSTGRES_USER=medidispatch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=medidispatch

# --- Cookies --------------------------------------------------------------------
# Keep true in production (HTTPS). Set false ONLY for a local http:// trial.
SESSION_COOKIE_SECURE=true

# --- AI harness ------------------------------------------------------------------
AI_ENABLED=true
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CONNECT_TIMEOUT=2
OLLAMA_READ_TIMEOUT=12
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_COOLDOWN_SECONDS=60

# --- Policy -------------------------------------------------------------------------
MEDIA_RETENTION_DAYS=30
ADMIN_CAN_VIEW_PATIENT_DATA=false
HOSPITAL_NEARBY_RADIUS_KM=60
EMERGENCY_NUMBER=112

# --- Seeding (scripts/seed_data.py) ---------------------------------------------------
SEED_ADMIN_USERNAME=superadmin
# SEED_ADMIN_PASSWORD=   # leave unset to generate one (printed once)
